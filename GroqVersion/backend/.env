# Copy this file to .env and fill in your OWN keys.
# Never commit the real .env file — only this .example file (with
# placeholders) should go into version control.

OLLAMA_API_KEY=Ollama_API_KEY_HERE
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

GROQ_API_KEY=grok_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

PORT=5000

# Once deployed with the frontend on GitHub Pages, restrict CORS to it:
ALLOWED_ORIGINS=https://yourusername.github.io
